# ==============================================================================
# AI-Powered Repository Impact Intelligence System - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL with pgvector, or SQLite for local dev)
DATABASE_URL=sqlite:///./repo_impact.db

# GitHub OAuth App Configuration (Increment 5)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# Local development default — MUST be overridden in production on Render:
#   GITHUB_OAUTH_REDIRECT_URI=https://impactintel.onrender.com/api/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Application URLs & Security
FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=dev_jwt_secret_key_repo_impact_2026
GITHUB_WEBHOOK_SECRET=dev_webhook_secret

# Optional GitHub App Credentials (for automated PR webhook analysis)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_API_BASE_URL=https://api.github.com

# GitHub App slug (the URL-name shown in github.com/apps/<slug>)
# Required in production for the "Install App" button to work
GITHUB_APP_SLUG=impactintel

# Dev bypass — allows mock OAuth and sample-repo fallback locally (NEVER set true in production)
ALLOW_DEV_BYPASS=false

# Frontend Configuration (in frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_ENABLE_DEV_BYPASS=false   # set true only for local dev without real GitHub credentials
